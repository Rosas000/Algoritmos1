            if (notas[i] > mayor) {
                mayor = notas[i];
            }

            if (notas[i] < menor) {
                menor = notas[i];
            }

            suma = suma + notas[i];

            if (notas[i] >= 3.0) {
                aprobados = aprobados + 1;
            } else {
                reprobados = reprobados + 1;
            }

        }

        promedio = suma / 30;

        System.out.println("La nota mayor es: " + mayor);
