import java.util.ArrayList;

public class Compra {

    int numero;
    String fecha;
    Cliente cliente;
    ArrayList<Producto> productos;

    
    public Compra(int numero, String fecha, Cliente cliente) {

        this.numero = numero;
        this.fecha = fecha;
        this.cliente = cliente;
        productos = new ArrayList<>();

    }

    public void agregarProducto(Producto producto) {

        productos.add(producto);

    }

    public double calcularTotal() {

        double total = 0;

        for (Producto producto : productos) {

            total = total + producto.calcularSubtotal();

        }

        return total;

    }

    public void mostrarInformacion() {

        System.out.println("Número de compra: " + numero);
        System.out.println("Fecha: " + fecha);

        System.out.println("Cliente: " + cliente.nombre);
        System.out.println("Correo: " + cliente.correo);
        System.out.println("Identificación: " + cliente.identificacion);

        System.out.println("\nProductos:");

        for (Producto producto : productos) {

            System.out.println("- " + producto.nombre);
            System.out.println("  Precio: $" + producto.precio);
            System.out.println("  Cantidad: " + producto.cantidad);
            System.out.println("  Subtotal: $" + producto.calcularSubtotal());

        }

        System.out.println("\nTotal a pagar: $" + calcularTotal());

    }

}
